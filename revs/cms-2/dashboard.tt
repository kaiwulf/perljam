<% title = 'Dashboard' %>

<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 30px;">
    <div class="card" style="text-align: center;">
        <h3 style="font-size: 2.5rem; color: #2563eb;">
            <% posts.size || 0 %>
        </h3>
        <p style="color: #64748b;">Blog Posts</p>
    </div>
    
    <div class="card" style="text-align: center;">
        <h3 style="font-size: 2.5rem; color: #10b981;">
            <% pages.size || 0 %>
        </h3>
        <p style="color: #64748b;">Pages</p>
    </div>
    
    <div class="card" style="text-align: center;">
        <h3 style="font-size: 2.5rem; color: #f59e0b;">
            <% media_count || 0 %>
        </h3>
        <p style="color: #64748b;">Media Files</p>
    </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px;">
    <div class="card">
        <div class="card-title" style="display: flex; justify-content: space-between; align-items: center;">
            <span>Recent Posts</span>
            <a href="/admin/posts/new" class="btn btn-primary" style="font-size: 0.8rem; padding: 6px 12px;">
                + New Post
            </a>
        </div>
        
        <% IF posts.size %>
        <table class="table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Updated</th>
                </tr>
            </thead>
            <tbody>
                <% FOREACH post IN posts %>
                <tr>
                    <td>
                        <a href="/admin/posts/<% post.id %>/edit" style="color: inherit; text-decoration: none; font-weight: 500;">
                            <% post.title %>
                        </a>
                    </td>
                    <td>
                        <% IF post.published %>
                        <span class="badge badge-success">Published</span>
                        <% ELSE %>
                        <span class="badge badge-warning">Draft</span>
                        <% END %>
                    </td>
                    <td style="color: #64748b; font-size: 0.9rem;">
                        <% post.updated_at %>
                    </td>
                </tr>
                <% END %>
            </tbody>
        </table>
        <% ELSE %>
        <p style="text-align: center; color: #64748b; padding: 30px;">
            No posts yet. <a href="/admin/posts/new">Create your first post</a>
        </p>
        <% END %>
    </div>
    
    <div class="card">
        <div class="card-title" style="display: flex; justify-content: space-between; align-items: center;">
            <span>Recent Pages</span>
            <a href="/admin/pages/new" class="btn btn-primary" style="font-size: 0.8rem; padding: 6px 12px;">
                + New Page
            </a>
        </div>
        
        <% IF pages.size %>
        <table class="table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Slug</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <% FOREACH page IN pages %>
                <tr>
                    <td>
                        <a href="/admin/pages/<% page.id %>/edit" style="color: inherit; text-decoration: none; font-weight: 500;">
                            <% page.title %>
                        </a>
                    </td>
                    <td style="color: #64748b; font-family: monospace;">
                        /<% page.slug %>
                    </td>
                    <td>
                        <% IF page.published %>
                        <span class="badge badge-success">Published</span>
                        <% ELSE %>
                        <span class="badge badge-warning">Draft</span>
                        <% END %>
                    </td>
                </tr>
                <% END %>
            </tbody>
        </table>
        <% ELSE %>
        <p style="text-align: center; color: #64748b; padding: 30px;">
            No pages yet. <a href="/admin/pages/new">Create your first page</a>
        </p>
        <% END %>
    </div>
</div>

<div class="card" style="margin-top: 30px;">
    <div class="card-title">Quick Links</div>
    <div style="display: flex; gap: 15px; flex-wrap: wrap;">
        <a href="/" target="_blank" class="btn btn-secondary">🌐 View Site</a>
        <a href="/admin/media" class="btn btn-secondary">📁 Media Library</a>
        <% IF session.role == 'admin' %>
        <a href="/admin/users" class="btn btn-secondary">👥 Manage Users</a>
        <a href="/admin/settings" class="btn btn-secondary">⚙️ Settings</a>
        <% END %>
    </div>
</div>
