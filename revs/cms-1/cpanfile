# OpenCy CMS - Perl Dependencies
# Install with: cpanm --installdeps .

# Core server (perljam)
requires 'IO::Async', '>= 0.79';
requires 'Future', '>= 0.49';
requires 'Future::AsyncAwait', '>= 0.66';
requires 'HTTP::Date';
requires 'File::MimeInfo';
requires 'JSON::PP';
requires 'URI::Escape';
requires 'Digest::SHA';
requires 'MIME::Base64';
requires 'Cwd';

# Database
requires 'DBI', '>= 1.643';
requires 'DBD::SQLite', '>= 1.72';

# Backend (Dancer2)
requires 'Dancer2', '>= 1.0.0';
requires 'Dancer2::Plugin::Database';
requires 'Dancer2::Session::Simple';
requires 'Template', '>= 3.100';
requires 'Text::Markdown';
requires 'HTML::Escape';
requires 'HTTP::Tiny';

# Optional but recommended
recommends 'Digest::Argon2';    # Better password hashing
recommends 'Plack';             # PSGI support
recommends 'Starman';           # Production server
recommends 'YAML::XS';          # Faster YAML

on 'test' => sub {
    requires 'Test::More';
    requires 'Test::Deep';
    requires 'Plack::Test';
    requires 'HTTP::Request::Common';
};

on 'develop' => sub {
    requires 'App::Prove';
    requires 'Perl::Critic';
    requires 'Perl::Tidy';
};
